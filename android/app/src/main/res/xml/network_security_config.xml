<?xml version="1.0" encoding="utf-8"?>
<!-- SÉCURITÉ : HTTPS obligatoire, uniquement les certificats système -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
